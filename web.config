<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config que se publica a IIS.

  WebDAV está instalado en el servidor de IIS y se adueña de PUT y DELETE
  antes de que lleguen a la API, respondiendo 405 (Method Not Allowed).
  Se quita sólo para este sitio: actualizar y eliminar viajes usan esos
  métodos.

  El handler aspNetCore y el elemento <aspNetCore> van escritos aquí a
  propósito. Son los que le dicen a IIS que esta carpeta es una app .NET;
  sin ellos IIS la trata como archivos estáticos y responde 403.14. No se
  deja que la publicación los agregue sola.

  processPath apunta al .exe porque se publica como autocontenido.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\APIV2.exe" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
