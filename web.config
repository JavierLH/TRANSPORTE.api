<?xml version="1.0" encoding="utf-8"?>
<!--
  Base del web.config que se publica. Al publicar, .NET agrega aquí el
  handler aspNetCore; lo que esté escrito en este archivo se conserva.

  WebDAV está instalado en el servidor de IIS y se adueña de PUT y DELETE
  antes de que lleguen a la API, respondiendo 405 (Method Not Allowed).
  Se quita sólo para este sitio: actualizar y eliminar viajes usan esos
  métodos.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
      </handlers>
    </system.webServer>
  </location>
</configuration>
